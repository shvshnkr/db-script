{% extends 'layout/app.html.twig' %}

{% block title %}{{ t('LOGIN', 'Login') }} — {{ site_name }}{% endblock %}

{% block body %}
<h1>{{ t('LOGIN', 'Login') }}</h1>
{% if error %}
<p class="dbs-error">{{ error }}</p>
{% endif %}
<form method="post" class="dbs-form">
    <label>{{ t('LOGIN', 'Login') }}
        <input name="login" required autocomplete="username">
    </label>
    <label>{{ t('PASS', 'Password') }}
        <input type="password" name="password" required autocomplete="current-password">
    </label>
    <button type="submit">{{ t('ENTER', 'Sign in') }}</button>
</form>
{% endblock %}
