{% extends 'layout/app.html.twig' %}

{% block title %}{{ result.visual_name }} — {{ site_name }}{% endblock %}

{% block body %}
<h1>{{ result.visual_name }} <small>({{ result.table }})</small></h1>
<p class="dbs-meta">
  <a href="w-arch.php">← {{ t('BROWSE', 'Tables') }}</a>
  · {{ t('RF_PRINTLIM', 'Total') }}: {{ result.total }}
  · {{ t('PAGE', 'Page') }} {{ result.page }}
</p>
{% if columns is not empty %}
<div class="dbs-table-wrap">
<table class="dbs-table">
  <thead>
    <tr>{% for col in columns %}<th>{{ col }}</th>{% endfor %}</tr>
  </thead>
  <tbody>
  {% for row in result.rows %}
    <tr>{% for col in columns %}<td>{{ row[col] }}</td>{% endfor %}</tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<p>{{ t('NOTUSED', 'No rows') }}</p>
{% endif %}
{% endblock %}
